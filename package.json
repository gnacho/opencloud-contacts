{
  "name": "opencloud-contacts",
  "version": "0.4.3",
  "private": true,
  "description": "OpenCloud Contacts App – reads contacts from Radicale via CardDAV",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@opencloud-eu/extension-sdk": "^8.0.0",
    "@opencloud-eu/web-client": "^8.0.0",
    "@opencloud-eu/web-pkg": "^8.0.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@opencloud-eu/tsconfig": "^8.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "vue3-gettext": "4.0.1"
  },
  "engines": {
    "pnpm": ">=10.28.1"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "@module-federation/dts-plugin>axios": "^1.20.0",
      "@module-federation/dts-plugin>ws": "^8.21.0",
      "@module-federation/dts-plugin>adm-zip": "^0.6.1"
    }
  }
}
