#!/bin/sh
# Forced command for the deploy-contacts user's SSH keys — see deploy/server/SETUP.md.
# Install as /usr/local/bin/contacts-deploy (owner root, mode 755).
#
# A key bound to this command can do exactly two things: upload into the app
# directory and restart the OpenCloud containers. No shell, no other path.
set -eu

APP_DIR=/mnt/HC_Volume_103940066/opencloud_keycloak_data/data/web/assets/apps/opencloud-contacts

case "${SSH_ORIGINAL_COMMAND:-}" in
  "rsync --server "*)
    # rrsync reads SSH_ORIGINAL_COMMAND itself, confines every path to APP_DIR
    # and, with -wo, refuses downloads.
    exec rrsync -wo "$APP_DIR"
    ;;
  restart)
    exec sudo -n -u dockeruser /usr/local/sbin/contacts-restart
    ;;
  *)
    echo "contacts-deploy: command not allowed: ${SSH_ORIGINAL_COMMAND:-<none>}" >&2
    exit 1
    ;;
esac
